META_VERIFY_TOKEN=choose-a-random-string
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional: defaults to GEMINI_MODEL when blank
GEMINI_STT_MODEL=
DB_PATH=nouba.db
CORS_ORIGINS=http://localhost:5173

# Intent-first conversation controller. auto selects configured Gemini, else Ollama.
CONVERSATION_CORE=v2
CONVERSATION_PROVIDER=auto
# Optional override for the selected provider's model.
CONVERSATION_MODEL=
CONVERSATION_GEMINI_MODEL=gemini-3.6-flash
CONVERSATION_THINKING_LEVEL=minimal
CONVERSATION_TIMEOUT_SECONDS=6

# Legacy extraction / optional local conversation model (independent of voice)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=35
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=180
OLLAMA_KEEP_ALIVE=2m
# Disabled by default. Set to gemini to enable configured remote text fallback.
LLM_FALLBACK_PROVIDER=
STT_PROVIDER=gemini
